# ===============================================
# Backend Environment Variables - Abogados Asociados
# ===============================================
# IMPORTANTE: Copiar este archivo como .env y configurar con valores reales
# NUNCA subir el archivo .env al repositorio

# -----------------------------------------------
# Database Configuration
# -----------------------------------------------
# URL de conexión a MySQL
# Formato: jdbc:mysql://[host]:[puerto]/[nombre_bd]?parametros
DB_URL=jdbc:mysql://localhost:3306/abogados_asociados?useSSL=false&allowPublicKeyRetrieval=true

# Usuario de la base de datos
DB_USERNAME=root

# Contraseña de la base de datos (dejar vacío si no tiene password en desarrollo)
DB_PASSWORD=

# -----------------------------------------------
# JWT Security Configuration
# -----------------------------------------------
# Secret key para firmar tokens JWT
# REQUISITO: Mínimo 256 bits (32 caracteres)
# PRODUCCIÓN: Generar un secret seguro aleatorio
# Ejemplo para generar: openssl rand -base64 32
JWT_SECRET=abogados-asociados-secret-key-change-in-production-minimum-256-bits-required-for-security

# Tiempo de expiración del token en milisegundos
# Default: 86400000 = 24 horas
JWT_EXPIRATION=86400000

# -----------------------------------------------
# Server Configuration (Opcional)
# -----------------------------------------------
# Puerto del servidor (por defecto 8019)
# SERVER_PORT=8019

# Perfil activo de Spring (dev, prod, test)
# SPRING_PROFILES_ACTIVE=dev
