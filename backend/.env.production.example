# Production Environment Configuration
# =====================================
# IMPORTANT: This file contains production-specific settings
# DO NOT commit actual secrets to version control

# Database Configuration (Production)
DB_URL=jdbc:mysql://production-db-host:3306/abogados_asociados_prod?useSSL=true&requireSSL=true
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

# JWT Configuration (Production)
# CRITICAL: Generate a secure random secret for production
# Command: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE_MINIMUM_256_BITS
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8019
SPRING_PROFILES_ACTIVE=prod

# Additional Production Settings
# Enable HTTPS
# server.ssl.enabled=true
# server.ssl.key-store=classpath:keystore.p12
# server.ssl.key-store-password=your-keystore-password
# server.ssl.key-store-type=PKCS12
