<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.ToggleButton?> 
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="j.m.ui.MainController" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ToolBar prefHeight="40.0" prefWidth="200.0">
        <items>
          <Button onAction="#handleCrearExpediente" text="Crear Nuevo" />
          <Button fx:id="editarButton" onAction="#handleEditarExpediente" text="Editar Seleccionado" />
          <Button onAction="#handleEliminarExpediente" text="Eliminar Seleccionado" />
          <Button onAction="#handleConvertirPDF" text="Convertir a PDF" />
          
          <Region HBox.hgrow="ALWAYS" />
          
          <Button fx:id="sincronizarButton" onAction="#handleSincronizar" text="Sincronizar Cambios" disable="true" />
          <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" text="Modo Oscuro" />
        </items>
      </ToolBar>
      
      <TableView fx:id="expedientesTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="numeroColumn" prefWidth="120.0" text="Número" />
          <TableColumn fx:id="materiaColumn" prefWidth="150.0" text="Materia" />
          <TableColumn fx:id="demandanteColumn" prefWidth="200.0" text="Demandante" />
          <TableColumn fx:id="demandadoColumn" prefWidth="200.0" text="Demandado" />
          <TableColumn fx:id="estadoColumn" prefWidth="230.0" text="Estado Actual" />
        </columns>
      </TableView>
   </children>
</VBox>