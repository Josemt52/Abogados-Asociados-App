<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.ToggleButton?> 
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="j.m.ui.MainController" minHeight="400.0" minWidth="400.0" prefHeight="600.0" prefWidth="900.0" maxHeight="Infinity" maxWidth="Infinity" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ToolBar prefHeight="40.0" minHeight="40.0" maxHeight="Infinity" VBox.vgrow="NEVER" style="-fx-padding: 8 8 8 8;">
        <items>
          <Button onAction="#handleCrearExpediente" text="Crear Nuevo" minWidth="100.0" maxWidth="Infinity" />
          <Button fx:id="editarButton" onAction="#handleEditarExpediente" text="Editar Seleccionado" minWidth="120.0" maxWidth="Infinity" />
          <Button fx:id="eliminarButton" onAction="#handleEliminarExpediente" text="Eliminar Seleccionado" minWidth="120.0" maxWidth="Infinity" />
          <Button onAction="#handleConvertirPDF" text="Convertir a PDF" minWidth="110.0" maxWidth="Infinity" />
          <TextField fx:id="busquedaField" promptText="Buscar por número..." onKeyReleased="#handleBuscarExpediente"
            minWidth="220.0" maxWidth="220.0" prefWidth="220.0"
            style="-fx-font-size: 14px; -fx-padding: 6 14 6 14; -fx-background-radius: 8; -fx-border-radius: 8;" />
          <Region HBox.hgrow="ALWAYS" />
          <Button fx:id="sincronizarButton" onAction="#handleSincronizar" text="Sincronizar Cambios" disable="true" minWidth="140.0" maxWidth="Infinity" />
          <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" text="Modo Oscuro" minWidth="110.0" maxWidth="Infinity" />
        </items>
      </ToolBar>
      
      <TableView fx:id="expedientesTable" VBox.vgrow="ALWAYS" minHeight="200.0" maxHeight="Infinity" minWidth="400.0" maxWidth="Infinity">
        <columns>
          <TableColumn fx:id="numeroColumn" prefWidth="120.0" text="Número" />
          <TableColumn fx:id="materiaColumn" prefWidth="150.0" text="Materia" />
          <TableColumn fx:id="demandanteColumn" prefWidth="200.0" text="Demandante" />
          <TableColumn fx:id="demandadoColumn" prefWidth="200.0" text="Demandado" />
          <TableColumn fx:id="estadoColumn" prefWidth="230.0" text="Estado Actual" />
        </columns>
      </TableView>
   </children>
</VBox>