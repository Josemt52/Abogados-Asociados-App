APP_NAME="Abogados Asociados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abogados_asociados
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Déjalo vacío para consumir /api desde el mismo dominio de Laravel.
VITE_API_URL=

JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

# Ruta o comando opcional; vacío intenta detectar libreoffice/soffice en PATH.
# Los DOC requieren este binario; los DOCX usan PHPWord como respaldo si falla.
LIBREOFFICE_BINARY=
LIBREOFFICE_TIMEOUT=120

# ONLYOFFICE Docs (la URL pública debe ser HTTPS en producción).
ONLYOFFICE_SERVER_URL=https://office.abogadosyasociados.net.pe
# Opcional: origen interno alcanzable por Laravel para descargar callbacks.
ONLYOFFICE_INTERNAL_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_HEADER_PREFIX=Bearer
# Segundos para el JWT de configuración; minutos para las URLs firmadas.
ONLYOFFICE_CONFIG_TOKEN_TTL_SECONDS=3600
ONLYOFFICE_DOCUMENT_URL_TTL_MINUTES=15
ONLYOFFICE_CALLBACK_URL_TTL_MINUTES=1440
# Bloqueo renovable de una sesión activa; si se pierde el callback, expira solo.
ONLYOFFICE_SESSION_LEASE_MINUTES=120
# Reserva corta desde que se entrega la config hasta recibir status 1.
ONLYOFFICE_SESSION_STARTUP_LEASE_MINUTES=5
ONLYOFFICE_SESSION_TOKEN_TTL_SECONDS=86400
ONLYOFFICE_HEARTBEAT_INTERVAL_SECONDS=60
ONLYOFFICE_MASTER_REBUILD_STALE_MINUTES=10
ONLYOFFICE_DOWNLOAD_TIMEOUT=120
ONLYOFFICE_MAX_DOCUMENT_BYTES=10485760
