APP_NAME="Abogados Asociados"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://expedientes.abogadosyasociados.net.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Reemplaza estos tres valores con los creados en el perfil de Hestia.
# Hestia normalmente antepone el nombre del perfil a la base y al usuario.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=USUARIOHESTIA_expedientes
DB_USERNAME=USUARIOHESTIA_expedientes
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_HESTIA
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=expedientes_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=expedientes_cache

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@abogadosyasociados.net.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# El frontend y la API comparten dominio; vacío hace que Vue consuma /api.
VITE_API_URL=

# Se genera en la VPS con: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

FRONTEND_URL=https://expedientes.abogadosyasociados.net.pe

# Conversión fiel de DOC/DOCX y detección de resoluciones en DOC legado.
LIBREOFFICE_BINARY=/usr/bin/libreoffice
LIBREOFFICE_TIMEOUT=120
